{
  "name": "plastic",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "generate": "bun scripts/generate-components.ts",
    "dev": "bun run registry:build && concurrently -k -n generate,docs \"bun --watch scripts/generate-components.ts --build-registry\" \"react-router dev\"",
    "build": "bun run registry:build && react-router build",
    "build:pages": "DOCS_BASE_PATH=/plastic/ bun run build && cp -R build/client/plastic/. build/client/",
    "start": "serve ./build/client --config serve.json",
    "lint": "bun run generate && oxlint",
    "format": "prettier --write \"**/*.{ts,tsx,mdx}\"",
    "typecheck": "bun run generate && react-router typegen && tsc --noEmit",
    "storybook": "bun run generate && concurrently -k -n generate,storybook \"bun --watch scripts/generate-components.ts\" \"STORYBOOK=true storybook dev -p 6006\"",
    "build-storybook": "bun run generate && STORYBOOK=true storybook build",
    "test": "bun run test:unit && bun run test-storybook",
    "test:unit": "vitest --config vitest.config.ts run",
    "test-storybook": "bun run generate && STORYBOOK=true vitest --config vite.config.ts --project storybook run",
    "registry:build": "bun run generate && bunx --bun shadcn@latest build registry.json --output public/r",
    "registry:validate": "bun run generate && bunx --bun shadcn@latest registry validate ./registry.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fumadocs/story": "^1.2.0",
    "@react-router/node": "^8.3.0",
    "bloom-menu": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.1.0",
    "framer-motion": "^13.1.1",
    "fumadocs-core": "16.14.5",
    "fumadocs-mdx": "15.3.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.5",
    "isbot": "^5.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@react-router/dev": "^8.3.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "concurrently": "^10.0.5",
    "fast-check": "^4.9.0",
    "fumadocs-typescript": "^5.3.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "oxlint": "^1.78.0",
    "playwright": "latest",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "serve": "^14.2.6",
    "shadcn": "^4.18.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "latest"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
